<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Oddfellow · Private access</title><style>
:root{color-scheme:dark;--bg:#0b0d12;--card:#121722;--line:#293043;--text:#eef2ff;--muted:#9aa4b7;--accent:#8b5cf6;--bad:#fb7185}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 30% 0,#19142c 0,#0b0d12 48%);color:var(--text);font:16px system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh;display:grid;place-items:center;padding:22px}.card{width:min(100%,440px);background:rgba(18,23,34,.96);border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:0 24px 70px #0008}.mark{width:48px;height:48px;border-radius:16px;background:linear-gradient(135deg,#8b5cf6,#38bdf8);box-shadow:0 0 40px #8b5cf655}h1{margin:18px 0 4px;font-size:30px}.sub{color:var(--muted);margin-bottom:22px}.field{margin:13px 0}.field label{display:block;font-size:13px;color:var(--muted);margin:0 0 6px}.field input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:#090c12;color:var(--text);outline:none}.field input:focus{border-color:#8b5cf6}button{width:100%;border:0;border-radius:12px;padding:13px 16px;font-weight:700;background:var(--accent);color:white;margin-top:8px}.msg{font-size:13px;color:var(--muted);min-height:20px;margin-top:12px}.bad{color:var(--bad)}.tabs{display:flex;gap:8px;margin:16px 0}.tabs button{margin:0;background:#1a2130}.tabs button.active{background:#40306f}.hidden{display:none}.tiny{font-size:12px;color:var(--muted);line-height:1.5}</style></head><body>
<div class="card"><div class="mark"></div><h1>Oddfellow</h1><div class="sub">Private owner access</div>
<div class="tabs"><button id="loginTab" class="active" onclick="mode('login')">Sign in</button><button id="enrollTab" onclick="mode('enroll')">First setup</button></div>
<div id="loginPane"><div class="field"><label>Password</label><input id="loginPass" type="password" autocomplete="current-password"></div><button onclick="login()">Sign in</button><div class="tiny" style="margin-top:12px">Your owner record stays on this device. Your plaintext password is never stored.</div></div>
<div id="enrollPane" class="hidden"><div class="field"><label>One-time setup code</label><input id="setupCode" type="password" autocomplete="one-time-code"></div><div class="field"><label>Your name</label><input id="ownerName" autocomplete="name"></div><div class="field"><label>Create password (10+ characters)</label><input id="ownerPass" type="password" autocomplete="new-password"></div><button onclick="enroll()">Create owner profile</button><div class="tiny" style="margin-top:12px">Use First setup only on a device you control. The setup code is delivered separately.</div></div>
<div id="msg" class="msg"></div></div>
<script>
const recKey='oddfellow_owner_record_v1';function mode(m){document.getElementById('loginPane').classList.toggle('hidden',m!=='login');document.getElementById('enrollPane').classList.toggle('hidden',m!=='enroll');document.getElementById('loginTab').classList.toggle('active',m==='login');document.getElementById('enrollTab').classList.toggle('active',m==='enroll');msg('')}
function msg(t,bad=false){const e=document.getElementById('msg');e.textContent=t;e.classList.toggle('bad',bad)}
async function post(url,body){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.detail||'Request failed');return d}
async function enroll(){try{msg('Creating secure owner profile…');const d=await post('/api/enroll',{setup_code:setupCode.value,name:ownerName.value,password:ownerPass.value});localStorage.setItem(recKey,d.owner_record);location.href='/'}catch(e){msg(e.message,true)}}
async function login(){const r=localStorage.getItem(recKey);if(!r){mode('enroll');msg('No owner record is stored on this device. Complete First setup.',true);return}try{msg('Signing in…');await post('/api/login',{owner_record:r,password:loginPass.value});location.href='/'}catch(e){msg(e.message,true)}}
if(!localStorage.getItem(recKey))mode('enroll');
</script></body></html>