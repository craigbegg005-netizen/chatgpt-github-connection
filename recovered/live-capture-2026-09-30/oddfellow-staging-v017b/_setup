<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><meta name=theme-color content="#090d13"><title>Set up Oddfellow</title><style>body{font-family:system-ui;max-width:420px;margin:10vh auto;padding:0 18px;background:#090d13;color:#eef3f8}input,button{box-sizing:border-box;width:100%;padding:13px;margin:6px 0;border-radius:10px;border:1px solid #303b4b;background:#111823;color:#fff}button{background:#eef3f8;color:#090d13;font-weight:700}small{color:#9ab}#m{color:#ff8585}</style></head><body><h2>Set up Oddfellow</h2><small>One owner only. Your password is hashed and is never shown back.</small><input id=code type=password placeholder="One-time setup code" autocomplete=one-time-code><input id=name placeholder="Your name" autocomplete=name><input id=password type=password placeholder="Password (12–200 characters)" autocomplete=new-password><button onclick=go()>Create owner</button><p id=m></p><script>async function go(){const r=await fetch('/setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({setup_code:code.value,name:name.value,password:password.value})});const d=await r.json().catch(()=>({}));if(r.ok)location='/';else m.textContent=d.error||'Failed'}</script></body></html>